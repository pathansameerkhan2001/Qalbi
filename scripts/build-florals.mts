/**
 * Writes QALBI's floral artwork as static SVG files and a manifest.
 *
 *   npm run florals:build
 *
 * Colours come from the brand tokens in src/app/globals.css (@theme): the
 * floral shades are mixed from them exactly as CSS color-mix(in srgb) would.
 * Output (both committed; re-run after changing the artwork or the tokens):
 *   public/florals/<variant>.svg          one file per arrangement (src/lib/florals/art.ts), opening as it loads
 *   public/florals/<variant>.still.svg    the same, still and fully open (for reduced motion)
 *   src/lib/florals/manifest.ts           URLs with a content hash (?v=…) and image sizes
 * The hashed URL lets the files be cached for a year (next.config.ts headers).
 */
import { createHash } from "node:crypto";
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { arrangements, floralSize, floralSvg, type FloralPalette, type FloralVariant } from "../src/lib/florals/art.ts";

const css = readFileSync("src/app/globals.css", "utf8");
const token = (name: string): string => {
  const m = new RegExp(`--color-${name}:\\s*(#[0-9a-fA-F]{6})`).exec(css);
  if (!m) throw new Error(`Brand token --color-${name} not found in globals.css`);
  return m[1].toLowerCase();
};

/** color-mix(in srgb, a <share>, b): channel-wise blend of the gamma-encoded values. */
const mix = (a: string, share: number, b: string) => {
  const ch = (hex: string, i: number) => parseInt(hex.slice(1 + i * 2, 3 + i * 2), 16);
  return `#${[0, 1, 2].map((i) => Math.round(ch(a, i) * share + ch(b, i) * (1 - share)).toString(16).padStart(2, "0")).join("")}`;
};

/** Owner-approved floral colours (not design tokens): the --fl-* custom properties in globals.css. */
const floral = (name: string): string => {
  const m = new RegExp(`--fl-${name}:\\s*(#[0-9a-fA-F]{6})`).exec(css);
  if (!m) throw new Error(`Floral colour --fl-${name} not found in globals.css`);
  return m[1].toLowerCase();
};

const ivory = token("ivory");
const goldPale = token("gold-pale");
const goldSoft = token("gold-soft");
const gold = token("gold");
const palette: FloralPalette = {
  petalLight: ivory,
  petal: mix(goldPale, 0.8, goldSoft),
  petalMid: mix(goldPale, 0.35, goldSoft),
  petalDeep: mix(goldSoft, 0.7, gold),
  petalLine: gold,
  bloom: ivory,
  bloomLine: goldSoft,
  centre: gold,
  leaf: token("sage"),
  leafDeep: token("botanical"),
  stem: token("botanical"),
  blushLight: mix(floral("blush"), 0.35, ivory),
  blush: floral("blush"),
  blushDeep: floral("blush-deep"),
};

mkdirSync("public/florals", { recursive: true });
const entries: string[] = [];
let total = 0;
for (const variant of Object.keys(arrangements) as FloralVariant[]) {
  const svg = floralSvg(variant, palette);
  const still = floralSvg(variant, palette, { animate: false });
  writeFileSync(`public/florals/${variant}.svg`, svg);
  writeFileSync(`public/florals/${variant}.still.svg`, still);
  const hash = (text: string) => createHash("sha256").update(text).digest("hex").slice(0, 10);
  const { width, height } = floralSize(variant);
  entries.push(`  ${variant}: { src: "/florals/${variant}.svg?v=${hash(svg)}", still: "/florals/${variant}.still.svg?v=${hash(still)}", width: ${width}, height: ${height} },`);
  total += svg.length;
  console.log(`${variant.padEnd(8)} ${(svg.length / 1024).toFixed(1).padStart(5)} KB (still ${(still.length / 1024).toFixed(1)} KB)`);
}
writeFileSync(
  "src/lib/florals/manifest.ts",
  `// Generated by scripts/build-florals.mts — do not edit by hand.\nimport type { FloralVariant } from "./art.ts";\n\nexport const floralFiles: Record<FloralVariant, { src: string; still: string; width: number; height: number }> = {\n${entries.join("\n")}\n};\n`,
);
console.log(`total ${(total / 1024).toFixed(1)} KB, palette ${JSON.stringify(palette)}`);
