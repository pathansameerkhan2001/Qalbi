# ---------------------------------------------------------------------------
# QALBI Naturals — environment variables
# Copy to .env.local for development and add the same keys in Vercel.
# Never commit real values. Server-only unless prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://qalbinaturals.in

# --- Shopify Storefront API -------------------------------------------------
# Shopify admin → Settings → Apps → Develop apps (or the Headless channel).
# Required scopes: unauthenticated_read_product_listings,
# unauthenticated_read_product_tags, unauthenticated_write_checkouts,
# unauthenticated_read_checkouts, unauthenticated_read_content (blog/policies).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Preferred: private (server) token from the Headless channel.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Alternative: public Storefront access token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# "true" only if the token has unauthenticated_read_product_inventory.
SHOPIFY_INVENTORY_ACCESS=false
# Collection handle used for "The QALBI Favourites" on the homepage.
SHOPIFY_BESTSELLERS_COLLECTION=bestsellers
# Shopify blog handle for the Journal (leave empty to use src/data/content.ts).
SHOPIFY_BLOG_HANDLE=
# Shared secret for POST /api/revalidate?secret=... (catalogue refresh webhook).
SHOPIFY_REVALIDATION_SECRET=
# Shopify customer account URL (e.g. https://shopify.com/<shop-id>/account). Enables /account redirect.
SHOPIFY_CUSTOMER_ACCOUNT_URL=
# Set to "true" in production to never fall back to development fixtures.
COMMERCE_DISABLE_FIXTURES=false

# --- Store database (Supabase) ---------------------------------------------
# "supabase" = sell the products managed in /admin with Cash on Delivery and
# pay-by-phone checkout (requires supabase/migrations/*.sql to be run first).
# Leave empty to keep the preview catalogue. Ignored while Shopify is configured.
COMMERCE_SOURCE=

# --- Supabase (admin login, store data, website images) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://mspcxmnuaroalpruohzt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BayAh8Zvrp049C19yt-bUQ_chXBV2w2
# Public bucket holding all website images (paths mirror /public/assets).
NEXT_PUBLIC_SUPABASE_ASSETS_BUCKET=qalbi-naturals-media
# "supabase" only AFTER `npm run assets:upload` has verified every file; otherwise "local".
NEXT_PUBLIC_ASSET_SOURCE=local
# SERVER-ONLY secret key (Supabase → Project Settings → API Keys). Never prefix with NEXT_PUBLIC_.
# Required for on-site checkout and stored enquiries: the website server uses it ONLY to call
# place_order_checked() / record_enquiry_checked() (rate-limited; supabase/production/04).
# Admin actions never use it — they run as the signed-in administrator under RLS.
# Also lets `npm run assets:upload` upload the website images. Prefer a dedicated secret key you can rotate.
SUPABASE_SERVICE_ROLE_KEY=

# --- Instagram (optional) ---------------------------------------------------
# Instagram API with Instagram Login for the official @qalbinaturals
# professional account, permission: instagram_business_basic.
# Long-lived tokens expire after 60 days — refresh before expiry.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v23.0

# --- Form delivery ----------------------------------------------------------
# Option A: email via Resend (https://resend.com). FORMS_FROM_EMAIL must be on a verified domain.
RESEND_API_KEY=
FORMS_FROM_EMAIL="QALBI Website <forms@your-verified-domain.com>"
FORMS_TO_EMAIL=qalbinaturals@gmail.com
# Option B: HTTPS webhooks (CRM, Zapier, Make, Google Apps Script, ...).
ENQUIRY_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
# Optional shared secret sent as X-Qalbi-Signature header to webhooks.
FORMS_WEBHOOK_SECRET=

# --- Analytics (optional, consent-gated) -------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
